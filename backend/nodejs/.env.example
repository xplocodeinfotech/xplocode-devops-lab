# OPTIONAL for the local demo: every value below is already the default (matching docker-compose.yml),
# so you can run the API without creating a .env file. Copy this file to .env only to change something.
PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=studentdb
DB_USER=gp_user
DB_PASSWORD=gp_pass
DB_SSL=false
DB_POOL_MAX=2
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200

# REQUIRED when NODE_ENV=production (cloud): a random value of 16+ characters. Never commit the real one.
# Generate one with: node -p "require('crypto').randomBytes(32).toString('base64url')"
# JWT_SECRET=
JWT_EXPIRES_IN=3600

# --- Zoho Catalyst Data Store (only when DB_PROVIDER=catalyst; see README "Use the Zoho Catalyst Data Store") ---
# DB_PROVIDER=catalyst
# CATALYST_PROJECT_ID=
# CATALYST_CLIENT_ID=
# CATALYST_CLIENT_SECRET=
# CATALYST_REFRESH_TOKEN=
# CATALYST_ENVIRONMENT=Development
# Defaults are the India data centre. For other regions change both (for example .com or .eu):
# CATALYST_API_DOMAIN=https://api.catalyst.zoho.in
# CATALYST_ACCOUNTS_DOMAIN=https://accounts.zoho.in
